#!/usr/bin/env python3
"""Pre-commit: block commits with broken farm data, or system code whose tests fail."""
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
staged = subprocess.run(["git", "-C", str(root), "diff", "--cached", "--name-only"],
                        capture_output=True, text=True, check=True).stdout.split()

if any(p == "data/farm.sql" or p.startswith("data/migrations/") for p in staged):
    r = subprocess.run([sys.executable, str(root / "bin" / "farm"), "check", "--staged"])
    if r.returncode != 0:
        print("pre-commit: farm data check failed; commit blocked", file=sys.stderr)
        sys.exit(1)

SYSTEM = ("tools/", "bin/", ".githooks/", ".claude/hooks/", ".claude/settings.json")
if any(p.startswith(SYSTEM) for p in staged):
    # Tests run against the working tree; commit only what you have tested.
    r = subprocess.run([sys.executable, str(root / "bin" / "test")])
    if r.returncode != 0:
        print("pre-commit: farm system tests failed; commit blocked", file=sys.stderr)
        sys.exit(1)
