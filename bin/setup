#!/usr/bin/env python3
"""One-time setup per clone: use the versioned git hooks in .githooks/."""
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
r = subprocess.run(["git", "-C", str(root), "config", "core.hooksPath", ".githooks"])
if r.returncode != 0:
    sys.exit("setup: could not set core.hooksPath")
print("setup: git hooks enabled (core.hooksPath=.githooks)")
